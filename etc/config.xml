<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <zaver_paylater>
                <active>0</active>
                <model>Zaver\Payment\Model\Paylater</model>
                <title>Zaver-Später bezahlen</title>
                <order_status_pending>pending_payment</order_status_pending>
                <allowspecific>0</allowspecific>
                <can_order>1</can_order>
                <can_initialize>1</can_initialize>
                <can_use_checkout>1</can_use_checkout>
                <can_refund>1</can_refund>
                <can_void>1</can_void>
                <can_edit>1</can_edit>
                <can_capture>1</can_capture>
                <can_authorize>1</can_authorize>
                <can_use_internal>0</can_use_internal>
                <allowed_currencies>EUR</allowed_currencies>
            </zaver_paylater>
            <zaver_installments>
                <active>0</active>
                <model>Zaver\Payment\Model\Installments</model>
                <title>Zaver-Ratenzahlung</title>
                <order_status_pending>pending_payment</order_status_pending>
                <allowspecific>0</allowspecific>
                <can_order>1</can_order>
                <can_initialize>1</can_initialize>
                <can_use_checkout>0</can_use_checkout>
                <can_refund>1</can_refund>
                <can_void>1</can_void>
                <can_edit>1</can_edit>
                <can_capture>1</can_capture>
                <can_authorize>1</can_authorize>
                <can_use_internal>0</can_use_internal>
                <allowed_currencies>EUR</allowed_currencies>
            </zaver_installments>
            <zaver_paymentlink>
                <active>1</active>
                <model>Zaver\Payment\Model\Paymentlink</model>
                <title>Zaver-Paymentlink</title>
                <order_status_pending>pending_payment</order_status_pending>
                <allowspecific>0</allowspecific>
                <method>order</method>
                <payment_action>order</payment_action>
                <message><![CDATA[Click <a href="%link%">here</a> to pay for your purchase.]]></message>
                <instructions/>
                <can_initialize>1</can_initialize>
                <can_use_checkout>1</can_use_checkout>
                <can_order>1</can_order>
                <can_refund>1</can_refund>
                <can_refund_partial_per_invoice>1</can_refund_partial_per_invoice>
                <can_use_internal>1</can_use_internal>
                <can_cancel>1</can_cancel>
                <can_authorize_vault>0</can_authorize_vault>
                <can_edit>1</can_edit>
                <can_capture>1</can_capture>
                <can_authorize>0</can_authorize>
                <allowed_currencies>EUR</allowed_currencies>
            </zaver_paymentlink>
            <zaver_banktransfer>
                <active>1</active>
                <model>Zaver\Payment\Model\Banktransfer</model>
                <title>Zaver-Banktransfer</title>
                <order_status_pending>pending_payment</order_status_pending>
                <allowspecific>0</allowspecific>
                <can_order>1</can_order>
                <can_initialize>1</can_initialize>
                <can_use_checkout>0</can_use_checkout>
                <can_refund>1</can_refund>
                <can_void>1</can_void>
                <can_edit>1</can_edit>
                <can_capture>1</can_capture>
                <can_authorize>1</can_authorize>
                <can_use_internal>0</can_use_internal>
                <allowed_currencies>EUR</allowed_currencies>
            </zaver_banktransfer>
        </payment>
    </default>
</config>
