<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="../../../../../lib/internal/Magento/Framework/ObjectManager/etc/config.xsd">
    <type name="Zaver\Payment\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Zaver\Catalog\Block\Product">
            <arguments>
            <argument name="infoBlockType" xsi:type="string">Zaver\Payment\Catalog\Block\Product\View</argument>
            <argument name="valueHandlerPool" xsi:type="object">ZaverValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">ZaverCommandPool</argument>
        </arguments>
    </type>
    <type name="Magento\Catalog\Block\Product">
        <plugin name="custom-text" type="Zaver\Payment\Catalog\Block\Product\View"/>
    </type>
    <type name="Zaver\Payment\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">zaver</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Zaver\Payment\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
    <type name="Zaver\Payment\Model\Payment">
        <arguments>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Zaver\Payment\Block\Info\Zaver_Paymentlink</argument>
            <argument name="valueHandlerPool" xsi:type="object">ZaverValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">ZaverCommandPool</argument>
        </arguments>
    </type>
    <type name="Zaver\Payment\Model\Paylater">
        <arguments>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Zaver\Payment\Block\Info\Base</argument>
            <argument name="valueHandlerPool" xsi:type="object">ZaverValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">ZaverCommandPool</argument>
        </arguments>
    </type>
    <type name="Zaver\Payment\Controller\Paylink\CreatePaylink">
        <arguments>
            <argument name="formBlockType" xsi:type="string">Zaver\Payment\Block\Form\zaver_paymentlink</argument>
            <argument name="infoBlockType" xsi:type="string">Zaver\Payment\Block\Info\Zaver_Paymentlink</argument>
             <argument name="valueHandlerPool" xsi:type="object">ZaverPaymentlinkValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">ZaverCommandPool</argument>
            <argument name="validatorPool" xsi:type="object">ZaverPaymentlinkValidatorPool</argument>
        </arguments>
    </type>
        <type name="Zaver\Payment\Model\Paymentlink">
        <arguments>
            <argument name="formBlockType" xsi:type="string">Zaver\Payment\Block\Form\zaver_paymentlink</argument>
            <argument name="infoBlockType" xsi:type="string">Zaver\Payment\Block\Info\Zaver_Paymentlink</argument>
            <argument name="valueHandlerPool" xsi:type="object">ZaverPaymentlinkValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">ZaverCommandPool</argument>
            <argument name="validatorPool" xsi:type="object">ZaverPaymentlinkValidatorPool</argument>
        </arguments>
    </type> 
    <virtualType name="ZaverPaymentlinkValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">ZaverPaymentlinkConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ZaverPaymentlinkConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">ZaverPaymentlinkConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="ZaverPaymentlinkConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Zaver\Payment\Model\Paymentlink::CODE</argument>
        </arguments>
    </virtualType>

    <virtualType name="ZaverPaymentlinkValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">ZaverPaymentlinkCountryValidator</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ZaverPaymentlinkCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">ZaverPaymentlinkConfig</argument>
        </arguments>
    </virtualType>
        <virtualType name="ZaverValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">ZaverConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ZaverConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">ZaverGenericConfig</argument>
        </arguments>
    </virtualType>

    <virtualType name="ZaverGenericConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Zaver\Payment\Model\Payment::CODE</argument>
        </arguments>
    </virtualType>

    <type name="Zaver\Payment\Observer\StartPayment\StartPaylink">
        <arguments>
            <argument name="zaver" xsi:type="object">Zaver\Payment\Model\Payment\Proxy</argument>
            <argument name="helper" xsi:type="object">Zaver\Payment\Helper\Data</argument>
        </arguments>
    </type>

        <virtualType name="ZaverCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="order" xsi:type="string">ZaverOrderCommand</item>
                <item name="authorize" xsi:type="string">ZaverInitializeCommand</item>               
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="ZaverInitializeCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">ZaverInitializeRequestBuilder</argument>
        </arguments>
    </virtualType>

   <virtualType name="ZaverInitializeRequestBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite" />

    <virtualType name="ZaverOrderCommand" type="ZaverInitializeCommand">
        <arguments>
            <argument name="handler" xsi:type="object">Zaver\Payment\Helper\OrderHandler</argument>
        </arguments>
    </virtualType>


        <virtualType name="ZaverCommandManager" type="Magento\Payment\Gateway\Command\CommandManager">
        <arguments>
            <argument name="commandPool" xsi:type="object">ZaverCommandPool</argument>
        </arguments>
    </virtualType>
</config>